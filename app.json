{
  "expo": {
    "name": "Psiqui",
    "slug": "psiqui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/psiqui-logo.png",
    "scheme": "psiqui",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.psiqui.app",
      "infoPlist": {
        "NSCameraUsageDescription": "A Psiqui usa a câmera para as sessões de terapia por vídeo.",
        "NSMicrophoneUsageDescription": "A Psiqui usa o microfone para as sessões de terapia por vídeo."
      }
    },
    "android": {
      "package": "br.com.psiqui.app",
      "permissions": ["CAMERA", "RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/psiqui-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/psiqui-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
