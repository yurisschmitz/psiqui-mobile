# API Laravel — 10.0.2.2 é como o emulador Android enxerga o localhost da sua máquina.
# Em dispositivo físico, troque pelo IP da sua máquina na rede (ex.: http://192.168.0.10:8000/api).
# Em produção: https://psiqui.com.br/api/api (padrão do app quando a variável não existe)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Frontend web (tela de vídeo abre a sala da web). Produção: https://psiqui.com.br
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:8080
